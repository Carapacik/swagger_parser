{
  "openapi": "3.2.1",
  "info": {
    "title": "Sensor readings",
    "version": "1"
  },
  "paths": {
    "/sensor": {
      "get": {
        "operationId": "currentSensor",
        "parameters": [
          {
            "name": "queryParameters",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sensor-mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current sensor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensor"
                }
              }
            }
          }
        }
      }
    },
    "/racks/{rack}/sensors/{sensor}/reading": {
      "get": {
        "operationId": "read-sensor",
        "tags": [
          "sensor",
          "monitoring"
        ],
        "parameters": [
          {
            "name": "rack",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sensor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sensor ID and reading",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reading"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "post": {
        "operationId": "recordEvent",
        "parameters": [
          {
            "name": "body",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sensor recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensor"
                }
              }
            }
          }
        }
      }
    },
    "/events/note": {
      "post": {
        "operationId": "setNote",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sensor updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sensor"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Sensor": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "Reading": {
        "type": "array",
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ],
        "items": false
      }
    }
  }
}
