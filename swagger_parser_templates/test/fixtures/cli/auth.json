{
  "schema_url": "http://127.0.0.1:PORT/schema.yaml",
  "output_directory": "../auth",
  "schema_download": {
    "credentials": [
      {
        "origin": "http://127.0.0.1:PORT",
        "headers": {
          "Authorization": {
            "env": "TEMPLATE_SCHEMA_AUTH"
          }
        }
      }
    ]
  },
  "generation": {
    "http_client": "http",
    "templates": {
      "api": "templates/api.mustache"
    }
  }
}
