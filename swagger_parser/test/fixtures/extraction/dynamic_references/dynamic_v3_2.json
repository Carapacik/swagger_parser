{
  "openapi": "3.2.1",
  "$self": "./packets",
  "info": {
    "title": "Packets",
    "version": "1"
  },
  "components": {
    "schemas": {
      "DefaultPacket": {
        "$ref": "./dynamic_packet.json"
      },
      "Names": {
        "$id": "./names",
        "$ref": "./dynamic_packet.json",
        "$defs": {
          "Item": {
            "$dynamicAnchor": "item",
            "type": "string",
            "minLength": 2
          }
        }
      },
      "Choice": {
        "$id": "./choice",
        "$defs": {
          "Item": {
            "$dynamicAnchor": "item",
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "$ref": "./names"
          },
          {
            "type": "string"
          }
        ]
      },
      "StaticFallback": {
        "$id": "./static",
        "$defs": {
          "Item": {
            "$dynamicAnchor": "fixed",
            "type": "string"
          }
        },
        "anyOf": [
          {
            "$dynamicRef": "./dynamic_packet.json#fixed",
            "minimum": 2
          },
          {
            "$dynamicRef": "./dynamic_packet.json#/$defs/DefaultItem",
            "maximum": 3
          },
          {
            "$dynamicRef": "./dynamic_packet.json#/$defs/Disabled"
          },
          {
            "$dynamicRef": "./dynamic_packet.json#/$defs/Flags",
            "type": "array",
            "minItems": 1
          }
        ]
      },
      "Tree": {
        "$id": "./tree",
        "$dynamicAnchor": "node",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "$dynamicRef": "#node"
            }
          }
        ]
      },
      "NumberTree": {
        "$id": "./number-tree",
        "$dynamicAnchor": "node",
        "anyOf": [
          {
            "$ref": "./tree"
          },
          {
            "type": "integer"
          }
        ]
      },
      "Imported": {
        "$ref": "./dynamic_catalog.json#/components/schemas/Envelope"
      },
      "Combined": {
        "$defs": {
          "Positive": {
            "type": "integer",
            "minimum": 1
          }
        },
        "anyOf": [
          {
            "$ref": "#/components/schemas/Combined/$defs/Positive",
            "$dynamicRef": "./dynamic_packet.json#item",
            "multipleOf": 2
          },
          {
            "type": "string"
          }
        ]
      },
      "LabelPage": {
        "$id": "./labelpage",
        "$ref": "./dynamic_page.json",
        "$defs": {
          "Item": {
            "$dynamicAnchor": "pageItem",
            "type": "string",
            "minLength": 2
          }
        }
      },
      "NumberPage": {
        "$id": "./numberpage",
        "$ref": "./dynamic_page.json",
        "$defs": {
          "Item": {
            "$dynamicAnchor": "pageItem",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
