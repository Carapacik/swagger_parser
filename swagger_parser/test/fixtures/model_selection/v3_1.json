{
  "openapi": "3.1.2",
  "info": {
    "title": "Model selection",
    "version": "1"
  },
  "paths": {
    "/stations/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "debug",
          "in": "query",
          "required": false,
          "schema": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "default": "off"
          }
        }
      ],
      "get": {
        "operationId": "getStation",
        "tags": [
          "Stations"
        ],
        "parameters": [
          {
            "$ref": "header.json"
          },
          {
            "name": "debug",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selection",
            "in": "header",
            "schema": {
              "$ref": "#/components/schemas/ParameterOnly"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          },
          "404": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/stations": {
      "post": {
        "operationId": "postStation",
        "tags": [
          "Stations"
        ],
        "responses": {
          "201": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Station"
              }
            }
          }
        }
      }
    },
    "/other": {
      "get": {
        "operationId": "getOther",
        "parameters": [
          {
            "name": "debug",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Empty"
          }
        }
      }
    },
    "/only/{key}": {
      "get": {
        "operationId": "onlyParameters",
        "tags": [
          "Stations"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PathOnly"
              }
            }
          },
          {
            "$ref": "#/components/parameters/OnlyQuery"
          },
          {
            "name": "object",
            "in": "query",
            "style": "deepObject",
            "explode": true,
            "schema": {
              "$ref": "#/components/schemas/FlatOnly"
            }
          },
          {
            "name": "cookie",
            "in": "cookie",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CookieOnly"
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Station": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "readOnly": true
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "tree": {
            "$ref": "#/components/schemas/Tree"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Detail"
            }
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "graph": {
            "$ref": "#/components/schemas/GraphAlias"
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": [
          "active",
          "paused"
        ],
        "default": "active"
      },
      "Tree": {
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tree"
            }
          }
        }
      },
      "Detail": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "AuditRecord": {
        "type": "object",
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/AuditDetail"
          }
        }
      },
      "AuditDetail": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer"
          }
        }
      },
      "KeptAlias": {
        "$ref": "#/components/schemas/AuditRecord"
      },
      "UnusedA": {
        "type": "object",
        "properties": {
          "next": {
            "$ref": "#/components/schemas/UnusedB"
          }
        }
      },
      "UnusedB": {
        "type": "object",
        "properties": {
          "next": {
            "$ref": "#/components/schemas/UnusedA"
          }
        }
      },
      "UnusedAlias": {
        "$ref": "#/components/schemas/UnusedA"
      },
      "GraphAlias": {
        "$ref": "#/components/schemas/DeepGraph"
      },
      "DeepGraph": {
        "type": "object",
        "required": [
          "nested",
          "left",
          "right"
        ],
        "properties": {
          "nested": {
            "type": "object",
            "required": [
              "second"
            ],
            "properties": {
              "second": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "third"
                  ],
                  "properties": {
                    "third": {
                      "type": "object",
                      "required": [
                        "state"
                      ],
                      "properties": {
                        "state": {
                          "type": "string",
                          "enum": [
                            "active",
                            "paused"
                          ]
                        },
                        "shared": {
                          "$ref": "#/components/schemas/DeepShared"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "left": {
            "$ref": "#/components/schemas/DeepShared"
          },
          "right": {
            "$ref": "#/components/schemas/DeepShared"
          }
        }
      },
      "DeepShared": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string"
          },
          "next": {
            "$ref": "#/components/schemas/GraphAlias"
          }
        }
      },
      "ParameterOnly": {
        "type": "string",
        "enum": [
          "one",
          "two"
        ]
      },
      "PathOnly": {
        "type": "string",
        "enum": [
          "one",
          "two"
        ]
      },
      "QueryOnly": {
        "type": "string",
        "enum": [
          "one",
          "two"
        ]
      },
      "CookieOnly": {
        "type": "string",
        "enum": [
          "one",
          "two"
        ]
      },
      "FlatOnly": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "$ref": "#/components/schemas/QueryOnly"
          }
        }
      }
    },
    "parameters": {
      "OnlyQuery": {
        "name": "query",
        "in": "query",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/QueryOnly"
          }
        }
      }
    }
  }
}
