{
  "openapi": "3.2.1",
  "info": {
    "title": "Parameter defaults",
    "version": "1"
  },
  "paths": {
    "/native/{id}": {
      "get": {
        "operationId": "getNative",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "default": "ignored"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          }
        }
      }
    },
    "/stations": {
      "get": {
        "operationId": "getStations",
        "parameters": [
          {
            "name": "requiredLimit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 9
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          },
          {
            "name": "archived",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "North $1"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "paused"
              ],
              "default": "active"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "north",
                "west"
              ]
            }
          },
          {
            "name": "X-Region",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "west"
            }
          },
          {
            "name": "session",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string",
              "default": "guest"
            }
          },
          {
            "name": "stationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "station-id",
              "default": "unknown"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          }
        }
      }
    },
    "/submitForm": {
      "post": {
        "operationId": "submitForm",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "default": "ignored"
                  },
                  "count": {
                    "type": "integer",
                    "default": 3
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": false
                  },
                  "label": {
                    "type": "string",
                    "default": "default label"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "file"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "default": "ignored"
                  },
                  "count": {
                    "type": "integer",
                    "default": 3
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": false
                  },
                  "label": {
                    "type": "string",
                    "default": "default label"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/create": {
      "post": {
        "operationId": "createStation",
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Station"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStation"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Station": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateStation": {
        "type": "object",
        "default": {
          "name": "Root"
        },
        "properties": {
          "name": {
            "type": "string",
            "default": "Unnamed"
          }
        }
      }
    }
  }
}
