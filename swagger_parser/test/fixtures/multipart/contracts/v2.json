            "required": true,
            "type": "string",
            "x-nullable": true
          },
          {
            "name": "optionalText",
            "in": "formData",
            "required": false,
            "type": "string",
            "x-nullable": true
          },
          {
            "name": "requiredFile",
            "in": "formData",
            "required": true,
            "type": "file",
            "x-nullable": true
          },
          {
            "name": "optionalFile",
            "in": "formData",
            "required": false,
            "type": "file",
            "x-nullable": true
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
