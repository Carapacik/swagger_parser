      "post": {
        "operationId": "uploadNative",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "photo",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "Upload bytes."
          },
          {
            "name": "label",
            "in": "formData",
            "required": true,
            "type": "string",
            "description": "Required label."
          },
          {
            "name": "note",
            "in": "formData",
            "required": false,
            "type": "string",
            "description": "Optional note."
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
    },
    "/single": {
      "post": {
        "operationId": "uploadSingle",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "photo",
            "in": "formData",
            "required": false,
            "type": "file",
            "description": "Upload bytes."
          },
          {
            "name": "label",
            "in": "formData",
            "required": true,
            "type": "string",
            "description": "Required label."
          },
          {
            "name": "note",
            "in": "formData",
            "required": false,
            "type": "string",
            "description": "Optional note."
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
    },
