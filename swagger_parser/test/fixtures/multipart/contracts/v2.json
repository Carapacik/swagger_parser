  "definitions": {
    "Metadata": {
      "type": "object",
      "required": [
        "title",
        "details"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "required": [
            "count"
          ],
          "properties": {
            "count": {
              "type": "integer"
            }
          }
        }
      }
    }
