        ],
        "parameters": [
          {
            "$ref": "#/parameters/Photo"
          },
          {
            "$ref": "#/parameters/Label"
          },
          {
            "$ref": "#/parameters/Note"
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
    },
    "/inline": {
      "post": {
        "operationId": "uploadInline",
        "consumes": [
          "multipart/form-data"
        ],
        "parameters": [
          {
            "name": "photo",
            "in": "formData",
            "required": true,
            "type": "file",
            "description": "Upload bytes."
          },
          {
            "name": "label",
            "in": "formData",
            "required": true,
            "type": "string",
            "description": "Required label."
          },
          {
            "name": "note",
            "in": "formData",
            "required": false,
            "type": "string",
            "description": "Optional note."
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
    }
