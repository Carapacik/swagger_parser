            "required": false,
            "type": "string",
            "enum": [
              "ready",
              "",
              null
            ],
            "x-nullable": true
          },
          {
            "name": "code",
            "in": "formData",
            "required": false,
            "type": "integer",
            "enum": [
              1,
              2,
              null
            ],
            "x-nullable": true
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
    },
    "/nulls": {
