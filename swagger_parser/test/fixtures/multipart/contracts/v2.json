        "parameters": [
          {
            "name": "name",
            "in": "formData",
            "required": true,
            "type": "string"
          },
          {
            "name": "note",
            "in": "formData",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Saved."
          }
        }
      }
    },
    "/form-list": {
      "post": {
        "operationId": "formList",
