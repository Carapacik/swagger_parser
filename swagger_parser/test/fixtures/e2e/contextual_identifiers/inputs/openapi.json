{
  "openapi": "3.0.0",
  "info": {
    "title": "Example",
    "version": "1.0"
  },
  "paths": {
    "/filter": {
      "get": {
        "operationId": "type",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "part",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching item.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Foo"
                }
              }
            }
          }
        }
      }
    },
    "/part": {
      "get": {
        "operationId": "part",
        "responses": {
          "204": {
            "description": "No content."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Foo": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "part": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "part"
        ]
      }
    }
  }
}
