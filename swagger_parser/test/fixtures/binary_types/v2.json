          "type": "string"
        }
      }
    },
    "FileInfoAlias": {
      "$ref": "#/definitions/FileInfo"
    },
    "FileInfoList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FileInfoAlias"
      }
    },
    "ScalarFileId": {
      "type": "string"
    },
    "ScalarFileAlias": {
