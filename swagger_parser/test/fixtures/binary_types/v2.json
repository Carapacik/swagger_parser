{
  "swagger": "2.0",
  "info": {
    "title": "V1 regressions",
    "version": "1"
  },
  "paths": {
    "/download": {
      "get": {
        "operationId": "download",
        "responses": {
          "200": {
            "description": "Result",
            "schema": {
              "$ref": "#/definitions/BinaryAlias"
            }
          }
        },
        "produces": [
          "application/octet-stream"
        ]
      }
    },
    "/files": {
      "get": {
        "operationId": "listFiles",
        "responses": {
          "200": {
            "description": "Result",
            "schema": {
              "$ref": "#/definitions/FileInfoList"
            }
          }
        },
        "produces": [
          "application/json"
        ]
      }
    },
    "/file-id": {
      "get": {
        "operationId": "fileId",
        "responses": {
          "200": {
            "description": "Result",
            "schema": {
              "$ref": "#/definitions/ScalarFileAlias"
            }
          }
        },
        "produces": [
          "application/json"
        ]
      }
    },
    "/upload": {
      "post": {
        "operationId": "upload",
        "responses": {
